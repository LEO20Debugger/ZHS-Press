# ZHS Press — environment template.
# Copy to .env and fill in. Never commit .env.

# ---- Database ---------------------------------------------------------------
# MySQL 8. Migrations run as their own deploy step, never on app boot.
DATABASE_URL="mysql://zhs:password@localhost:3306/zhs_press"

# ---- API --------------------------------------------------------------------
API_PORT=4000
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS="http://localhost:3000"

# ---- Admin auth -------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- Flutterwave ------------------------------------------------------------
# BLOCKING PREREQUISITE: confirm with the account owner, before writing
# checkout code, that this merchant account can collect AND settle USD, and
# which API version it is provisioned for. The brief requires USD pricing.
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
# Set this to the same value in the Flutterwave dashboard webhook settings.
# The webhook handler compares the incoming verif-hash header against it using
# a constant-time comparison. Without it, anyone who can reach the endpoint can
# mark orders paid.
FLW_SECRET_HASH=""
FLW_BASE_URL="https://api.flutterwave.com/v3"

# ---- URLs -------------------------------------------------------------------
WEB_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"

# ---- Email ------------------------------------------------------------------
# Order receipts, newsletter double opt-in, submission acknowledgements and
# alerts, and waitlist notifications.
#
# One URL, in the form every provider hands you:
#   smtp://user:password@smtp.provider.com:587    STARTTLS  (prefer this)
#   smtps://user:password@smtp.provider.com:465   implicit TLS
#
# Resend — username is the literal word "resend", password is the API key.
# Use 587: their 465 was unreachable when tested, and a blocked SMTP port hangs
# rather than erroring. See docs/email.md.
#   smtp://resend:re_YOUR_API_KEY@smtp.resend.com:587
#
# Percent-encode the password if it contains @ / : or +.
#
# Leave blank and nothing breaks: messages are written to the log instead of
# sent, which is how you test double opt-in locally (copy the confirm URL out
# of the terminal). In production this is a real fault and the API says so at
# boot — customers who pay get no receipt, and nobody can complete a signup.
SMTP_URL=""

# Must be on a domain the provider has verified. An unverified From is accepted
# by the relay and then dropped or spam-filed, with no error anywhere.
MAIL_FROM="ZHS Press <hello@zhspress.org>"

# Where replies land, if MAIL_FROM is a no-reply address. Optional.
MAIL_REPLY_TO=""

# Internal recipient for new submission alerts. Defaults to MAIL_FROM.
PRESS_NOTIFY_EMAIL=""

# ---- Storage ----------------------------------------------------------------
# Product images upload to local disk, not S3. On Railway UPLOAD_DIR must point
# inside a mounted volume — a container filesystem does not survive a restart,
# so every deploy would otherwise wipe the catalogue's artwork.
UPLOAD_DIR="./uploads"
# Public base URL those files are served from. Pointing at localhost in
# production is refused: the URL is written into the database and would never
# load for anyone.
ASSET_BASE_URL="http://localhost:4000/uploads"

# The S3 variables below are NOT read by any code — kept as the shape of the
# eventual move to object storage. Setting them does nothing today.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="zhs-press"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
