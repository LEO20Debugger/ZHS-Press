USE_FIXTURES=true
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Shows the sandbox notice on the checkout page: "no payment is taken", plus
# the Flutterwave test card. Set to "true" whenever the API is running on
# FLWSECK_TEST_ keys. MUST be removed (or set to anything else) the moment live
# keys go in, or the shop tells real customers their money is not being taken.
NEXT_PUBLIC_PAYMENTS_TEST_MODE=true
